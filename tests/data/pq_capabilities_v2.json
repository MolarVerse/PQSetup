{
  "schema": "pq.capabilities",
  "schema_version": 2,
  "version": "v1.0.2",
  "build": {
    "ase": true,
    "mpi": false,
    "python_bindings": false,
    "python_embedding": true,
    "shared": true,
    "static": false,
    "singularity": false
  },
  "cli": {
    "input_validation": {
      "schema": "pq.validation",
      "schema_version": 1,
      "formats": [
        "text",
        "json"
      ],
      "scopes": [
        "portable",
        "installed"
      ]
    }
  },
  "input": {
    "job_types": [
      "mm-md",
      "mm-hessian",
      "mm-opt",
      "qm-md",
      "qm-rpmd"
    ],
    "qm_programs": [
      "dftbplus",
      "pyscf",
      "turbomole",
      "ase_dftbplus",
      "ase_xtb",
      "fennol",
      "mace",
      "mace_mp",
      "mace_off"
    ],
    "external_qm": {
      "script_mode": "bundled_or_full_path",
      "programs": {
        "dftbplus": {
          "recommended_script": "dftbplus_periodic_stress",
          "scripts": [
            {
              "name": "dftbplus_periodic_stress",
              "label": "DFTB+ periodic stress",
              "required_file_keywords": [
                "dftb_file"
              ]
            }
          ]
        },
        "pyscf": {
          "recommended_script": null,
          "scripts": [
            {
              "name": "pyscf_hf.py",
              "label": "UHF / STO-3G"
            },
            {
              "name": "pyscf_mp2.py",
              "label": "UMP2 / 6-311++G**"
            }
          ]
        },
        "turbomole": {
          "recommended_script": "turbomole_ricc2",
          "scripts": [
            {
              "name": "turbomole_ricc2",
              "label": "RI-MP2",
              "required_working_files": [
                "tm_define.template"
              ]
            }
          ]
        }
      }
    },
    "thermostats": [
      "none",
      "berendsen",
      "velocity_rescaling",
      "langevin",
      "nh-chain"
    ],
    "manostats": [
      "none",
      "berendsen",
      "stochastic_rescaling"
    ],
    "pressure_isotropies": [
      "isotropic",
      "xy",
      "xz",
      "yz",
      "anisotropic",
      "full_anisotropic"
    ],
    "parameters": {
      "nstep": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "timestep": {
        "type": "number",
        "unit": "fs",
        "exclusive_minimum": 0
      },
      "output_freq": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "random_seed": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      },
      "temp": {
        "type": "number",
        "unit": "K",
        "minimum": 0
      },
      "start_temp": {
        "type": "number",
        "unit": "K",
        "minimum": 0
      },
      "end_temp": {
        "type": "number",
        "unit": "K",
        "minimum": 0
      },
      "temp_ramp_steps": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483647
      },
      "temp_ramp_frequency": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      },
      "t_relaxation": {
        "type": "number",
        "unit": "ps",
        "exclusive_minimum": 0,
        "maximum": 1.7976931348623156e+305,
        "minimum_from": {
          "parameter": "timestep",
          "factor": 0.001
        },
        "default": 0.10000000000000001
      },
      "friction": {
        "type": "number",
        "unit": "ps^-1",
        "minimum": 0,
        "maximum": 1.7976931348623159e+296,
        "default": 0.10000000000000001
      },
      "nh-chain_length": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647,
        "default": 3
      },
      "coupling_frequency": {
        "type": "number",
        "unit": "cm^-1",
        "minimum": 0,
        "maximum": 4.4723633207419101e+143,
        "default": 1000
      },
      "pressure": {
        "type": "number",
        "unit": "bar"
      },
      "p_relaxation": {
        "type": "number",
        "unit": "ps",
        "exclusive_minimum": 0,
        "maximum": 1.7976931348623156e+305,
        "minimum_from": {
          "parameter": "timestep",
          "factor": 0.001
        },
        "default": 1
      },
      "compressibility": {
        "type": "number",
        "unit": "bar^-1",
        "minimum": 0,
        "default": 4.5909999999999999e-05
      },
      "density": {
        "type": "number",
        "unit": "kg/L",
        "exclusive_minimum": 0
      },
      "rcoulomb": {
        "type": "number",
        "unit": "angstrom",
        "minimum": 0,
        "default": 12.5
      }
    }
  }
}
